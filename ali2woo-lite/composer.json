{
    "name": "ali2woo/alinext-lite",
    "description": "drop shipping plugin for aliexpress and woocommerce",
    "type": "project",
    "license": "GPL",
    "authors": [
        {
            "name": "Ali2Woo Team",
            "email": "ma.group.plugins@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php-di/php-di": "^7.0",
        "automattic/jetpack-autoloader": "^2",
        "psr/container": "1.1.0"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ],
        "files": [
            "includes/functions.php",
            "includes/settings.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.0",
        "squizlabs/php_codesniffer": "^3.13"
    }
}
